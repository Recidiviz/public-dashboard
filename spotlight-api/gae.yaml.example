runtime: nodejs22

service: {SERVICE_NAME}

# Cap scaling so a traffic spike can't run up costs. Vanta's App Engine
# autoscaling test needs max_instances above 1.
automatic_scaling:
  min_instances: {MIN_INSTANCES}
  max_instances: {MAX_INSTANCES}

includes:
- base-gae-handlers.yaml

env_variables:
  GOOGLE_APPLICATION_CREDENTIALS: {GOOGLE_APPLICATION_CREDENTIALS}
  METRIC_BUCKET: {METRIC_BUCKET}
  AUTH_ENABLED: {AUTH_ENABLED}
